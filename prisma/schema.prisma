generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES
  ACCOUNTANT
}

enum VehicleStatus {
  IN_TRANSIT
  UNDER_PREP
  AVAILABLE
  RESERVED
  SOLD
}

enum FuelType {
  PETROL
  HYBRID
  DIESEL
  ELECTRIC
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum SteeringSide {
  LEFT_HAND
  RIGHT_HAND_CONVERTED
}

enum PaymentType {
  CASH
  INSTALLMENT
  BANK_TRANSFER
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum LeadStage {
  NEW_INQUIRY
  FOLLOW_UP
  TEST_DRIVE
  NEGOTIATION
  CLOSED_WON
  LOST
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)
  phone        String?
  sales        Sale[]   @relation("SellerSales")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id               String            @id @default(cuid())
  stockNumber      String            @unique
  vin              String            @unique
  make             String
  model            String
  year             Int
  trim             String?
  bodyType         String            @default("SUV")
  originCountry    String            @default("USA")
  steering         SteeringSide      @default(LEFT_HAND)
  customsClearance String            @default("Gomrok Herat - Verified")
  cleanTitle       Boolean           @default(true)
  mileage          Int
  fuelType         FuelType          @default(PETROL)
  transmission     TransmissionType  @default(AUTOMATIC)
  driveType        String            @default("AWD")
  color            String
  status           VehicleStatus     @default(AVAILABLE)
  purchasePrice    Float
  freightCost      Float             @default(0)
  customsDuty      Float             @default(0)
  repairCost       Float             @default(0)
  landedCost       Float
  minTargetPrice   Float             @default(0)
  sellingPrice     Float
  currency         String            @default("USD")
  features         String[]
  description      String
  descriptionDari  String?
  conditionNotes   Json?
  images           VehicleImage[]
  documents        VehicleDocument[]
  sales            Sale[]
  expenses         Expense[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([make, model, year])
  @@index([status])
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
  order     Int     @default(0)
}

model VehicleDocument {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  docType   String
  createdAt DateTime @default(now())
}

model Customer {
  id            String    @id @default(cuid())
  fullName      String
  phone         String
  whatsapp      String?
  tazkiraNumber String    @unique
  city          String    @default("Herat")
  address       String?
  tradeInRecord String?
  leadStage     LeadStage @default(NEW_INQUIRY)
  notes         String?
  sales         Sale[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Sale {
  id             String               @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id])
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id])
  sellerId       String
  seller         User                 @relation("SellerSales", fields: [sellerId], references: [id])
  salePrice      Float
  currency       String               @default("USD")
  exchangeRate   Float                @default(70.5)
  paymentType    PaymentType          @default(CASH)
  contractNumber String               @unique
  saleDate       DateTime             @default(now())
  notes          String?
  installments   InstallmentPayment[]
  createdAt      DateTime             @default(now())
}

model InstallmentPayment {
  id        String            @id @default(cuid())
  saleId    String
  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  amount    Float
  status    InstallmentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime          @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  category    String
  amount      Float
  currency    String   @default("USD")
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}
